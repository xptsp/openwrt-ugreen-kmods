#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

PROG="/usr/bin/hdd_led_monitor"

run_instance() {
    local section="$1"
    local enabled led_file interval device idle_color act_color fault_color smart_interval

    config_get_bool enabled "$section" enabled 0
    config_get led_file "$section" led_file
    config_get interval "$section" interval 100
    config_get device "$section" device
    config_get idle_color "$section" idle_color "000000"
    config_get act_color "$section" act_color "FFFFFF"
    config_get fault_color "$section" fault_color "FF0000"
    config_get smart_interval "$section" smart_interval 600

    [ "$enabled" -gt 0 ] || return 0
    [ -z "$led_file" ] && return 0
    [ -z "$device" ] && return 0

    procd_open_instance "$section"
    # Provide the newly added health args matching our updated positional signature:
    procd_set_param command "$PROG" "$led_file" "$interval" "$device" "$idle_color" "$act_color" "$fault_color" "$smart_interval"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    config_load hdd_led
    config_foreach run_instance hdd_led
}
